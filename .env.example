# App Configuration
APP_ENV=development
APP_PORT=8080
JWT_SECRET=change-me

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=absensi_golan
DB_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
MINIO_SECRET_KEY=change-me
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=golan-attendance

# SMTP / Password Reset Email
# Production wajib diisi. Contoh Gmail: smtp.gmail.com, port 587,
# SMTP_USER alamat Gmail, SMTP_PASSWORD App Password (bukan password biasa),
# dan SMTP_FROM biasanya sama dengan SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:4200

# Public SEO brand configuration (Angular values are maintained in
# frontend/src/environments/environment*.ts and compiled into the frontend)
APP_NAME=Absensi Golan Digital Kreatif
COMPANY_NAME=PT. Golan Digital Kreatif
PUBLIC_SITE_URL=https://domain-anda-nanti.com
LOGO_URL=https://domain-anda-nanti.com/assets/icon_golan.png
SOCIAL_IMAGE_URL=https://domain-anda-nanti.com/assets/social-share.svg
CONTACT_EMAIL=
CONTACT_PHONE=

# Browser Push (generate once with webpush.GenerateVAPIDKeys and keep stable)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# National Indonesian holiday source (SKB 3 Menteri via API Indonesia)
# Public SKB 3 Menteri mirror (no API key required)
NATIONAL_HOLIDAY_URL=https://api.kemendesa.link/libur-nasional/api/holidays/%d.json
NATIONAL_HOLIDAY_API_KEY=
